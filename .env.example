# ============================================================
# Edu-Planning — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=edu_planning

# --- Gemini AI API ---
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Open Router API (Fallback) ---
# Optional: For fallback AI generation if Gemini fails
# Get your key at: https://openrouter.ai/
OPEN_ROUTER_API_KEY=your_open_router_key_here

# --- Internal Node.js API Secret ---
# Used to authenticate PHP → Node.js requests.
# Generate a strong random string (e.g. openssl rand -hex 32)
INTERNAL_API_SECRET=your_strong_random_secret_here

# --- Node.js Server ---
# Port where the Express server runs (internal only, bound to 127.0.0.1)
PORT=3001

# --- Node.js Server ---
PORT=3001
